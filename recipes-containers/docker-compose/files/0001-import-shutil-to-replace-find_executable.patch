From 08ab951a7f85d5293601acc434d6e8f9241122c9 Mon Sep 17 00:00:00 2001
From: "po.cheng" <po.cheng@adlinktech.com>
Date: Wed, 4 Mar 2026 14:07:51 +0800
Subject: [PATCH] import shutil to replace find_executable

Signed-off-by: po.cheng <po.cheng@adlinktech.com>
---
 compose/cli/errors.py             | 6 +++---
 compose/cli/main.py               | 4 ++--
 tests/integration/service_test.py | 4 ++--
 3 files changed, 7 insertions(+), 7 deletions(-)

diff --git a/compose/cli/errors.py b/compose/cli/errors.py
index a807c7d..874d7d3 100644
--- a/compose/cli/errors.py
+++ b/compose/cli/errors.py
@@ -1,7 +1,7 @@
 import contextlib
 import logging
 import socket
-from distutils.spawn import find_executable
+import shutil
 from textwrap import dedent
 
 from docker.errors import APIError
@@ -114,11 +114,11 @@ def exit_with_error(msg):
 
 def get_conn_error_message(url):
     try:
-        if find_executable('docker') is None:
+        if shutil.which('docker') is None:
             return docker_not_found_msg("Couldn't connect to Docker daemon.")
         if is_docker_for_mac_installed():
             return conn_error_docker_for_mac
-        if find_executable('docker-machine') is not None:
+        if shutil.which('docker-machine') is not None:
             return conn_error_docker_machine
     except UnicodeDecodeError:
         # https://github.com/docker/compose/issues/5442
diff --git a/compose/cli/main.py b/compose/cli/main.py
index fabd608..058ffde 100644
--- a/compose/cli/main.py
+++ b/compose/cli/main.py
@@ -6,7 +6,7 @@ import pipes
 import re
 import subprocess
 import sys
-from distutils.spawn import find_executable
+import shutil
 from inspect import getdoc
 from operator import attrgetter
 
@@ -1547,7 +1547,7 @@ def exit_if(condition, message, exit_code):
 
 
 def call_docker(args, dockeropts, environment):
-    executable_path = find_executable('docker')
+    executable_path = shutil.which('docker')
     if not executable_path:
         raise UserError(errors.docker_not_found_msg("Couldn't find `docker` binary."))
 
diff --git a/tests/integration/service_test.py b/tests/integration/service_test.py
index 06a9750..292569c 100644
--- a/tests/integration/service_test.py
+++ b/tests/integration/service_test.py
@@ -2,7 +2,7 @@ import os
 import re
 import shutil
 import tempfile
-from distutils.spawn import find_executable
+import shutil
 from io import StringIO
 from os import path
 
@@ -171,7 +171,7 @@ class ServiceTest(DockerClientTestCase):
     @pytest.mark.xfail(True, reason='Option has been removed in Engine 17.06.0')
     def test_create_container_with_init_path(self):
         self.require_api_version('1.25')
-        docker_init_path = find_executable('docker-init')
+        docker_init_path = shutil.which('docker-init')
         service = self.create_service('db', init=docker_init_path)
         container = service.create_container()
         service.start_container(container)
-- 
2.34.1

